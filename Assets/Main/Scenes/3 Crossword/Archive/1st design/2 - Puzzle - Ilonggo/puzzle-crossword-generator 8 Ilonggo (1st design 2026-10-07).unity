  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Hiligaynon_Level8
  across:
  - 3. PARAS - This is one of the small bones that make up the spine.
  - 4. PUKING - This is the external part of the female genitalia.
  - 6. HOSO - This means to pull a weapon, like a sword, out of its case.
  - 7. DURO - This word describes a large number of something.
  - 8. KAGI - This means to violently rip something apart.
  - 11. KILAB - This is a brief, sudden burst of light.
  down:
  - 1. PALUKPUK - This is the hard central core of an ear of corn, left after the
    kernels are removed.
  - 2. SAHIN - This is the small part left over after most of something has been
    used.
  - 4. PUYO - This is a type of fish found in local waters.
  - 5. GAHI - This is the money someone earns for their work.
  - 9. ALWAK - This refers to liquid that has accidentally poured out of its container.
  - 10. DAIT - This is a state of calm with no conflict or war.
