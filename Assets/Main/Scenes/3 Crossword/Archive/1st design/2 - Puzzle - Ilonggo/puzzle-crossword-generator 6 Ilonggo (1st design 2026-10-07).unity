  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Hiligaynon_Level6
  across:
  - 2. APIKE - This phrase means something is about to happen very soon.
  - 5. TAKMO - This means to draw liquid or air into the mouth by creating suction.
  - 6. NYEBE - This is the soft, white frozen precipitation that falls in cold climates.
  - 9. WAWAW - This is a loud, sharp cry, like the sound a dog or wolf makes.
  - 10. NANO - This question word is used to ask for the identity or nature of something.
  down:
  - 1. BELA - This is a stick of wax with a wick, burned to give light.
  - 3. KIBO - This is a steady, rhythmic pulsing feeling or sound.
  - 4. DAAY - This is a small, compact chunk of soil.
  - 7. BADAHO - This is the small piece inside a bell that strikes its side to make
    sound.
  - 8. KADA - This word refers to every single one in a group, taken individually.
