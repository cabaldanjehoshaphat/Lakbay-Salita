  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Hiligaynon_Level7
  across:
  - 1. UYSIT - This describes someone who is experiencing good fortune and joy.
  - 5. PAYOPOT - This is a small round projection or fastener sticking out from a
    surface.
  - 7. DARA - This is the sister of one's mother or father.
  - 8. PAHABUG - This means to throw something with great force.
  - 10. WALO - This is the number that comes after seven.
  - 11. GOOD - This is an empty space or opening within something solid.
  down:
  - 2. SIDO - This is the sudden, involuntary spasm that makes a person hiccup.
  - 3. KARGADOR - This is a person hired to carry heavy loads or luggage.
  - 4. UTUD - This is the general term for a sibling.
  - 6. PANGGOI - This means to go out and gather seafood such as fish or crabs.
  - 9. APAS - This means to pursue or chase after someone or something.
