  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Tagalog_Level5
  across:
  - 1. HULA - This is a prediction of what will happen, especially about the weather.
  - 3. ANAK - This is a person's son or daughter.
  - 4. AGIW - This is the black powdery residue left behind by burning something.
  - 5. PULI - This is something used to take the place of another.
  - 7. IBILAD - This means to lay something outside so the sun's heat dries it.
  down:
  - 1. HIKA - This is a condition that makes breathing difficult due to narrowed
    airways.
  - 2. LALIKIN - This means to shape an object by spinning it against a cutting tool.
  - 5. PIPI - This describes someone who is unable to speak.
  - 6. NOOD - This means to watch a performance or program.
