  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Tagalog_Level7
  across:
  - 1. DAGASA - This describes someone who acts suddenly without thinking things
    through.
  - 3. MAYURYA - This is the larger part of a group, more than half.
  - 6. LUMITAW - This means to come into view or become visible.
  - 9. IGAPAS - This means to use a tool to cut down grass or crops.
  - 10. LUWAN - This is a type of edible marine algae.
  - 11. KUTA - This is a strong, defensive structure built to protect against attack.
  down:
  - 2. SERB - This means to perform duties for someone, or to present food to them.
  - 4. APAW - This describes a container so full that its contents spill over the
    edge.
  - 5. GUGUIN - This means to use a substance to wash and clean the hair.
  - 7. ISLA - This is a piece of land completely surrounded by water.
  - 8. AKYATAN - This means to carry an item up to a higher floor.
