  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Tagalog_Level8
  across:
  - 1. PAGANYAN - This word is used to describe something happening in that particular
    way.
  - 3. SUBIDO - This describes light or color that is extremely vivid and intense.
  - 6. PANSIPIT - This is a device set to catch and kill rats.
  - 9. TINGKALA - This is the ability to understand something fully.
  - 10. SEDATIBO - This is a medicine used to calm a person or help them sleep.
  - 11. MAHIGOP - This describes having the ability to drink a liquid slowly in small
    amounts.
  down:
  - 2. YODO - This is a chemical element used as an antiseptic for wounds.
  - 4. UMISTIMA - This means to provide enjoyment or amusement for someone.
  - 5. PAMBAYOK - This is a device or tool that produces a rapid shaking motion.
  - 6. PERAS - This is a sweet, bell-shaped fruit that grows on trees.
  - 7. PAGLINGO - This is the deliberate killing of a prominent or important person.
  - 8. TRAPO - This is a piece of old cloth used for cleaning.
