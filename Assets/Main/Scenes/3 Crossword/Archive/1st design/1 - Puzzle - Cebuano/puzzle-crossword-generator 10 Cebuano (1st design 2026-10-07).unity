  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Cebuano_Level10
  across:
  - 4. ATSARA - This is a dish of vegetables preserved in vinegar and spices.
  - 5. GUSOK - This is one of the curved bones that form the chest cage.
  - 7. BUGTO - This means to snap or separate something into pieces.
  - 9. BUNTAS - This describes someone who is extremely hungry from lack of food.
  - 11. KASUPAK - This is the person or side one competes against in a contest.
  - 13. KAKALMA - This is a state of being calm and peaceful.
  - 14. GIKAN - This word indicates the origin or starting point of something.
  down:
  - 1. LAGDU - This refers to tiny drops of liquid, such as water or rain.
  - 2. PATAK - This is an irregular patch or spot of color or dirt on a surface.
  - 3. KATAP - This means to cover an area completely and evenly.
  - 6. SUGBA - This means to cook food directly over glowing embers or coals.
  - 8. KUYAMANG - This describes the way small insects move slowly along a surface.
  - 10. UKBAN - This is a type of citrus fruit.
  - 12. PILYA - This describes someone, often a child, who enjoys playful mischief.
