  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Cebuano_Level7
  across:
  - 1. UBAS - This is a small, round, juicy fruit that grows in clusters on a vine.
  - 4. ASLUM - This describes a sharp, tangy taste like that of a lemon.
  - 6. PATA - This describes something dropping and landing with a soft, heavy sound.
  - 7. KILIM - This is the name for a certain large, tall tree species.
  - 9. INSPIRAR - This means to fill someone with the urge or ability to do something
    creative.
  - 10. DOBLE - This means twice as much, or two of something.
  down:
  - 2. BULILYUS - This is the bottle-shaped target that bowlers try to knock down.
  - 3. RAUK - This is the currency used to buy and sell goods.
  - 5. MAMILINO - This is the person who drives a horse-drawn carriage.
  - 6. PRUNA - This is a dried plum.
  - 8. DIAY - This word is used to express agreement or confirm a mild surprise.
