  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Cebuano_Level4
  across:
  - 1. ILBU - This is the bent pipe fitting used to change the direction of a pipeline.
  - 3. ITUT - This is the intimate physical act shared between two people in a relationship.
  - 5. SUGOD - This is the very start of something.
  - 7. HULUP - This means to land or come to rest on something, like a bird settling
    on a branch.
  down:
  - 2. UDTO - This is the middle of the day, exactly twelve o'clock.
  - 3. IMAS - This word means something extra has been included or added.
  - 4. AGULU - This is the low sound someone makes when in pain or discomfort.
  - 6. DIP - This is the dance move where one partner leans the other backward dramatically.
