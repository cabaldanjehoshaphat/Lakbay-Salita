  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3999ce003ef1043469c710b655231627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  puzzleSource: Cebuano_Level3
  across:
  - 4. RIN - This word is used to add another idea to what was just said.
  - 5. PANIG - This refers to one of the surfaces bordering something, or a party
    in a dispute.
  - 6. UNUSON - This describes wind that blows in strong, sudden bursts.
  - 7. IBOG - This is the feeling of wanting what someone else has.
  down:
  - 1. BIKUG - This means to shift or loosen something that has been fixed in place.
  - 2. SAB - This is the time of day between afternoon and nightfall.
  - 3. GISI - This means to tear or rip something roughly, leaving a jagged wound.
